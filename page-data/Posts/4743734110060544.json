th":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/bfad53d691a1f43e9cea15cfd332e17e3b9822fdf1a3615c2f425e515eb203d6deda45a602902a68649aa40b9949ebfd5f53fa44753a65a90f482e3b28ad8fa3","height":650,"url":"https://lh3.googleusercontent.com/akWbxMk7Ej8LzrOeta5H4yIskf77vyHpXbwovyFrWEPe2WKTr8uRMldrZsPKTsMWPPrai8PQODLt8qDBftgcGfdS7yJJLSBHIKqHnEbvJ6gvmBoiPw","width":1200},"link":{"aria_label":null,"href":"/blog/material-google-io23","label":null,"open_new_window":false},"section":"Material Blog","title":"Material Design at I/O ‘23"},"document_id":6223019476385792,"document_label":null,"repo_id":"mio-example"}]},"document_id":"4743734110060544"}