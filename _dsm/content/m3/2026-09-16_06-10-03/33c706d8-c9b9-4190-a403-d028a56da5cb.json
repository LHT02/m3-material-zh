-7_do.png?alt=media&token=5f9eac8b-0fc0-4a0b-a5f8-8b6b21391902","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"照片应用，其提示条（snackbar）显示“无法移动照片”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:33.703Z"},{"pageContentChunkId":"9da34e9a-a896-42a1-a292-1aed565904e1","pageContentChunkCanonId":"8cfe66bb-eca8-4fe1-9b99-4002ebc2090a","htmlValue":null,"footer":"<p>当代词指代的名词不明确时，避免使用代词，尤其是在解释用户操作时</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoacju-8_don't.png?alt=media&token=7611a7d7-d03f-4112-a2ce-188781885865","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"照片应用，其提示条显示“无法将照片移动到‘Travel’文件夹，因为该文件夹不可用”","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:33.703Z"}]},{"pageContentBlockId":"a77221b1-1ecd-42a3-b0aa-1376811ed8fa","pageContentBlockCanonId":"7f5533e9-c95b-4e8a-adce-90bb4ef01977","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"7ba9aa7c-0fb9-4ee0-b276-189e3a691b61","pageContentChunkCanonId":"20a93065-1a7f-4fbf-afb7-0445460c7a5a","htmlValue":"<h3>明确“this”和“that”的指代</h3><p id=\"isPasted\">句子不要以“this”或“that”开头，除非其后紧跟名词。当名词不明确时，句子会更难翻译。 </p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"},{"pageContentChunkId":"4d553c8a-6018-4f25-94d5-d2adc0aa291f","pageContentChunkCanonId":"37caab7b-4dd8-4126-90ac-0366d424123d","htmlValue":null,"footer":"<p>确保文本所指的对象清晰明确</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuobsfb-9_do.png?alt=media&token=f0e3f5ac-e9e8-4851-9659-73264a34a79a","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"表述清晰、未使用“this”或“that”的表单","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"},{"pageContentChunkId":"52a3b85f-651b-4f43-9421-184348e92957","pageContentChunkCanonId":"d627ebfe-1e35-44ba-91be-faa17d79acf9","htmlValue":null,"footer":"<p>避免使用“this”和“that”</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuocbnw-10_don't.png?alt=media&token=635d9dcb-45aa-4588-b3c1-ac0ce0fb3471","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"表单，其副标题显示“This can be seen by your IT administrator.”，“this”的指代对象并不明确。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:41.737Z"}]},{"pageContentBlockId":"23fc6807-d1cf-43d5-9854-5ea3c2e7a0a2","pageContentBlockCanonId":"8e70c13a-8008-4a56-a39b-0b1aac7fc2e6","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"22ea9a4a-daaa-4f43-9d54-4c85abf71130","pageContentChunkCanonId":"d62e2dec-7dc2-4d44-a55e-e9c51efc1a38","htmlValue":"<h3>避免习语、口语化和客套表达</h3><p id=\"isPasted\">如果含义不清晰，习语或口语化短语可能令人困惑。如果使用它们，请说明该短语的目的和上下文，帮助翻译人员选择合适的替代表达。</p><p>避免使用客套表达，例如“Please”“Sorry”和“Thank you”，尤其是在错误消息中。不过，在请用户做某件不太方便的事情时，可以使用“please”。</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-03T20:23:18.206Z"},{"pageContentChunkId":"fb15d52d-1035-463f-b502-1d66567ceec3","pageContentChunkCanonId":"8c6f188e-72e8-4a62-9dec-718dcf409564","htmlValue":null,"footer":"<p>清晰、日常的语言在配以图像时，也能以富有表现力和趣味的方式呈现</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fm48wnsm6-11_do.png?alt=media&token=4240e280-de1c-4f93-9a10-3ed047bf8fb9","imageUrlFife":"https://lh3.googleusercontent.com/fbOdPNZxbnWg8h1AtfrVzrHEfx87HqTbn1uV7XqiOCvs017tfdkalXYclDMLKuAlW2fhnxehv4sRAOflGxm7TFe7ckUfdhE57Pkwu57MUkZP=s656","imageHeight":600,"imageWidth":656,"altText":"带有插图、文字为“Let’s go”的空状态","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-03T20:23:18.206Z"},{"pageContentChunkId":"97e586ab-7569-4814-a7b9-7eb9d520afe8","pageContentChunkCanonId":"cadc1a8d-3da4-489b-be25-68c18c27f2fe","htmlValue":null,"footer":"<p>习语式短语不仅难以被所有人理解，也让翻译人员难以本地化</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fm48wp6t5-12_don't.png?alt=media&token=af4b491a-de3c-4c6a-bc88-bbb8eb79026d","imageUrlFife":"https://lh3.googleusercontent.com/hIGnwFcZ-4N3wxDr7EvS9-3j_B_l5DbU24maq8wmMOyakUI4sgTD9O-Ab5Ck8oxjJx0samUsMnB-Vlg40cWx6Yx3S9SHTgoqj9uGcQk-yDPv=s656","imageHeight":600,"imageWidth":656,"altText":"带有插图、文字为“Let’s get this party started”的空状态","videoUrl":null,"videoHei