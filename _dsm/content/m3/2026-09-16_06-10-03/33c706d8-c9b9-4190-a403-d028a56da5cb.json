93-406e-9c18-f82242d399ce","htmlValue":null,"footer":"<p>不要点名特定国家或文化的节日</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuo41ao-2_don't.png?alt=media&token=58df821b-9db0-4490-8f56-55d57eb6fd51","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"引用了圣诞节的空心愿清单屏幕","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:03.140Z"}]},{"pageContentBlockId":"19a8cbd6-4879-45bb-af3b-94bc1e7f274f","pageContentBlockCanonId":"c99bee67-035c-4509-8d91-78e186be213f","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunkId":"65f2de7b-0b99-477e-8569-d382aee95508","pageContentChunkCanonId":"2616a777-bef2-42b6-9dc7-35cbd3c33951","htmlValue":"<p>如果不适合使用全球性示例，请在消息描述中解释该指涉，以便翻译人员替换为特定区域设置的示例。应当指出本地化指涉的一些情况包括：</p><ul><li>地点</li><li>姓名（常见名字和昵称）</li><li>货币</li><li>温度</li><li>日期格式</li><li>服务商（互联网和有线电视）</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":