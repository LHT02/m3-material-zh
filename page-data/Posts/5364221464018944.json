document_label":null,"repo_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/acfbd66a60609d90be3ded54928339677052ff4002ecb1ac513d6909b7cc0330f5172522534fc6086b95701cf425c6d4419b058836e70ab4cea1e538f979afac","height":631,"url":"https://lh3.googleusercontent.com/7EjLvv4dU-s7letBC0X4Ic2fOxxKGFjlefFv4aA60U1uUm--_1JlUphBPkUOPAYdGDuAJqptxYsi-Tb4hJtvbzoqfQTISSXyu6jrGA","width":1200},"link":{"aria_label":null,"href":"/develop","label":null,"open_new_window":false},"section":"Develop","title":"Develop with Material"},"document_id":6262188537544704,"document_label":null,"repo_id":"mio-example"}]},"document_id":"5364221464018944"}