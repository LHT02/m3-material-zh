en=435653ba-a996-4701-a42d-ae6e5421242f","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"提示用户注册试用新产品的对话框","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:59.525Z"},{"pageContentChunkId":"864f0165-fe80-46fe-b2c5-0b3c25d77428","pageContentChunkCanonId":"76cffea8-4173-49e6-aaef-98e910fb7c45","htmlValue":null,"footer":"<p>令人困惑的语言会让人们难以理解自己正在执行的操作</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flvuoexnd-14_don't.png?alt=media&token=3138701a-0231-4b15-96a7-7d8a8a688e27","imageUrlFife":null,"imageHeight":300,"imageWidth":328,"altText":"文字冗长、令人困惑的对话框，提示用户注册新的通信偏好设置","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-05-21T19:51:59.525Z"}]},{"pageContentBlockId":"de587f25-bb50-462b-a2d2-8dbc2cf1d473","pageContentBlockCanonId":"842a1090-8f20-4a42-b97e-8743cdc4446a","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"1b9a4d91-f7e4-4f42-b3a8-f3e80416fc51","pageSectionCanonId":"639e149a-741e-4f60-8e61-a10c68edd030","contentChunks":[{"pageContentChunk