l,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2022-09-01T10:13:02.486Z"}]},{"pageContentBlockId":"f907b0f1-5d66-4732-82d4-f7501135793a","pageContentBlockCanonId":"df61269b-8035-4cae-8394-7c2befac38af","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"4d4457d3-58b3-451c-b575-c1b8d1d3e443","pageContentChunkCanonId":"f55bddf2-8186-4111-9735-079e23d1b691","htmlValue":"<h2 id=\"isPasted\">动态颜色让个人设备更有专属感</h2>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2022-09-01T14:24:01.857Z"}]},{"pageContentBlockId":"dc98cb67-ad54-4dc6-9310-9d4cd19be7eb","pageContentBlockCanonId":"b76d6b40-da19-441a-b184-5501bda6090c","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"9ccd37e0-ac72-468c-bb49-08c9a0498905","pageContentChunkCanonId":"6881354a-c55d-4409-8684-eaf8d66eba5c","htmlValue":"<p id=\"isPasted\">M3 为品牌颜色和个人颜色偏好创造了新的可能，使二者能够融合为独一无二的体验。配色方案既接纳了用颜色体现应用设计格调的需求，也尊重个人为自己选择的设置。 </p><p>通过启用动态颜色（dynamic color），应用既能保留定义并区分产品的颜色，又能让用户对自己最在意的样式拥有更多控制权。</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2022-09-01T14:23:55.664Z"}]},{"pageContentBlockId":"3fe75a18-ac44-4781-a8b3-4da3de189c51","pageContentBlockCanonId":"06d3ef4e-0f76-411a-b7b0-08d17cc737be","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"6378e6f7-fc6e-45d8-b0fd-d56c08a7fc31","pageContentChunkCanonId":"3dd223b2-06ec-4a42-98d4-0260b4aec609","htmlValue":"<h4 id=\"isPasted\">应用品牌颜色系统</h4><p>借助动态颜色和 M3 配色方案，应用的颜色会自动适应用户设置并与之融合。 </p><p>M3 支持以系统化的方式应用自定义参数，帮助你定义和维护传达品牌形象的样式。 </p><p>颜色系统会自动处理关键调整，以提供无障碍的颜色对比度、易读性、交互状态和组件结构。动态颜色同样适用于自定义（非 Material）组件。 </p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-03-11T09:59:27.834Z"},{"pageContentChunkId":"bd967e05-a3e8-4236-83ce-2a612a7577e5","pageContentChunkCanonId":"fa43105c-86f8-4781-848a-e26e39817fe6","htmlValue":null,"footer":"<p>应用可以采用来自基线方案、用户生成的动态颜色或自定义颜色的多种颜色</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fkuob4wl9-m3_Color-hiRes.gif?alt=media&token=1cd5b57b-ab91-4dca-9fe9-43011d9f2cde","imageUrlFife":null,"imageHeight":1024,"imageWidth":1023,"altText":"动画展示 3 种不同的源颜色级联应用到 UI 中，为屏幕上的元素重新着色","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-06-26T09:02:46.189Z"}]},{"pageContentBlockId":"ed48166e-7034-478e-a2b5-801abee39c4b","pageContentBlockCanonId":"05de6e0e-d15e-4555-905f-8dd4923d25c2","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"abe9a8e2-a089-4aa5-87de-8d607f7a7606","pageContentChunkCanonId":"dbb28fa6-8378-4f1f-a44d-22bd9c8f8fa9","htmlValue":"<h2 id=\"isPasted\">开始使用</h2>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2021-10-10T17:11:17.677Z"}]},{"pageContentBlockId":"67a36a75-c957-4075-893a-89445389e2f7","pageContentBlockCanonId":"488c9f51-10f5-468f-a1a2-86ec04c1b47f","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"0ba26211-8039-4311-9025-f4a6afee297c","pageContentChunkCanonId":"80ab4fde-6cb6-446a-8993-624b3f98991e","htmlValue":"<p>要使用个性化功能，你需要<strong>使用 M3 颜色系统构建自定义配色方案</strong>。 </p><p>为了让应用尊重用户在设备和应用层面的设置，<strong>你需要实现一个自定义主题，让用户生成的配色方案能够映射到它</strong>。 </p><p>此外，使用自定义主题还能确保你的应用为未启用动态颜色（dynamic color）的用户提供一套后备配色方案。</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-03-11T10:00:00.228Z"},{"pageContentChunkId":"da7e0f0b-d5d4-40b6-91ed-286cc6726703","pageContentChunkCanonId":"dc97d361-e0b8-4d90-ad1d-5d02a8011697","htmlValue":null,"footer":"<p>用户生成的配色方案可以贯穿使用自定义主题的应用</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fkufholeg-3p-brand_using-dynamic.png?alt=media&token=0861098c-24ec-4c53-be0b-5c11bbc572cc","imageUrlFife":"https://lh3.googleusercontent.com/4UkK7WPkGF34M64YsnpmKQSmBeoJm1TqBbbNIWgHivMGGydJZLLyT4ihwR0TsiiG_mcovyLhOvGYdrYhn7UPHpDZMXzCx6WBRkmjPHySkM2F=s2048","imageHeight":1330,"imageWidth":2048,"altText":"移动端 UI 视图拼贴，展示用户设置和偏好的绿色主色如何和谐地贯穿系统 UI","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-03-11T10:00:00.228Z"}]},{"pageContentBlockId":"71125d77-9fec-401f-a7fc-71b6527911e2","pageContentBlockCanonId":"8a9f3322-a7d5-4328-aa45-5fd964a71088","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"55e8fad6-95b8-477a-92ed-ca80834509a9","pageContentChunkCanonId":"fc19e25d-f3da-4b56-aa24-47c234f3b64a","htmlValue":"<h3>设置与教程</h3><p id=\"isPasted\">动态颜色（dynamic color）既是用户设置，也是开发者的选择。你可以有选择地应用动态颜色，使其与品牌配色方案协同工作。例如，应用中的个人资料或账户页面可以反映用户的配色方案设置，为应用中的个人空间增添个性。</p><h4 id=\"isPasted\">设置</h4><ul><li>你现有的品牌参数可以与 Material Design 集成，从而在整个产品中保持一致地应用</li><li>你也可以从零开始使用 Material Design，为项目创建一套全新的完整颜色系统</li></ul><h4 id=\"isPasted\">动态颜色教程</h4><p><a href=\"https://goo.gle/visualize-dynamic-color\" rel=\"noopener noreferrer\" target=\"_blank\">动态颜色 codelab</a> 是一个动手实践指南，帮助你直观了解设计和品牌颜色如何与动态颜色互动。它会引导你迈出下一步：使用 Figma 的 <a href=\"https://goo.gle/material-theme-builder-figma\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder</a> 插件将颜色应用于你的设计。  </p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-12-18T06:42:37.373Z"}]},{"pageContentBlockId":"c26971c3-2243-4967-b1c6-9ac5e2fb655f","pageContentBlockCanonId":"94cc449c-950f-4a08-99ab-ca0ae27bfc1f","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"afeb5d96-de0b-44bb-873e-531f5d3918bf","pageContentChunkCanonId":"80323e29-88ae-477e-87ea-7e52e142391a","htmlValue":"<h4 id=\"isPasted\">Material Theme Builder</h4><p>借助内置的代码导出功能，<a href=\"https://goo.gle/material-theme-builder-figma\" rel=\"noopener noreferrer\" target=\"_blank\">Material Theme Builder</a> Figma 插件让你轻松可视化设计、迁移到 M3 颜色系统，并充分利用动态颜色。 </p><p id=\"isPasted\">Material Theme Builder 会创建可导出为多种代码格式的<strong>颜色和字体令牌（token）</strong>。令牌是创建并维护样式值唯一可信来源的重要工具。该 Figma 插件以 Figma 样式的形式创建令牌，从而与现有的设计稿、品牌风格指南乃至设计系统对接。 </p><p><a href=\"https://github.com/material-foundation/material-tokens\" id=\"isPasted\" rel=\"noopener noreferrer\" target=\"_blank\">Material tokens</a> 以格式化主题文件的形式提供，开箱即用，其中包括 <a href=\"https://github.com/AdobeXD/design-system-package-dsp\" rel=\"noopener noreferrer\" target=\"_blank\">Design System Package (DSP)</a>。DSP 是一种表示设计系统信息的跨平台文件格式。<a href=\"/m3-material-zh/m3/pages/design-tokens/overview\" id=\"isPasted\">进一步了解设计令牌</a>。 </p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-10-09T05:16:10.999Z"},{"pageContentChunkId":"6a7a38dd-5b9b-4989-96b1-dcce3d5b5de1","pageContentChunkCanonId":"3ecd1bfa-4a47-45bc-a87f-521b121b33c2","htmlValue":null,"footer":"<p>Material Theme Builder Figma 插件帮助你创建自定义配色方案，并导出为多种代码格式</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fkufi1pz4-3p-brand_Material-theme-builder.png?alt=media&token=77f5a522-d7ce-4bff-9626-2da427e28f7a","imageUrlFife":"https://lh3.googleusercontent.com/7geIR4r6fJRbDja4YLYpoyn2BiZtjp_s-MJvrJZXNGKRw8mUt7GCeBj3BeCaViBz8S89DA6zq5P835YGXGVT3q-0iQoTwjdJEGLBNt50tkpF=s1026","imageHeight":744,"imageWidth":1026,"altText":"Material Theme Builder Figma 插件启动页面示例。图中展示了插件 UI 以及一系列紫色色调，作为可生成的调色板示例。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-10-09T05:16:10.999Z"}]},{"pageContentBlockId":"097fd1ee-be11-4c17-8f98-8a738e581364","pageContentBlockCanonId":"3db56216-7838-4677-9abc-41425bff1f37","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"58a88f7c-b970-40a7-9fb6-042d4c243531","pageContentChunkCanonId":"ef2515f0-cce7-4ecb-b9bc-49caeafebe35","htmlValue":"<h2 id=\"isPasted\">自定义配色方案</h2>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2022-09-01T14:24:29.461Z"}]},{"pageContentBlockId":"796a7efe-4a5f-4177-b357-bb05ad2066fd","pageContentBlockCanonId":"fb59a100-4e87-4e4c-bdec-df87c787a226","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"f326ef8d-0c70-4edd-88bf-c27aedaa721d","pageContentChunkCanonId":"208a8148-6f66-4acc-83ec-e236729f6db8","htmlValue":"<p>无论你是基于既有的品牌参数开展工作，还是尚未定义应用的颜色，Material Theme Builder 都能帮助你创建自定义颜色体验。</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2022-09-01T14:24:21.723Z"}]},{"pageContentBlockId":"ad79df1c-79fa-4561-9d1f-c47498464006","pageContentBlockCanonId":"b4bea241-95cb-4e46-9668-ddd37c760955","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"fa006eb9-bfd2-436f-9e9a-fc2440d3e7f1","pageContentChunkCanonId":"9a54712d-3379-42df-9dca-a0c2879dbcbf","htmlValue":"<p id=\"isPasted\">在 Material Theme Builder 中，你可以确定并输入一种或多种颜色来定义配色方案。添加第二种或第三种颜色是可选的，但会影响最终生成的配色方案。</p><p>将应用颜色映射到自定义方案的源颜色，可以与 <a href=\"/m3-material-zh/m3/pages/dynamic-color/overview\">M3 的动态颜色</a>在角色和逻辑上保持一致。 </p><p><strong>品牌颜色</strong>既可以作为单一颜色添加到工具中，也可以作为包含一系列色调的完整品牌调色板添加，从而在整个应用中实现一致、全面的颜色表达。 </p><p>如果你的应用使用单一品牌颜色或有限的品牌调色板，你可以输入主品牌颜色作为自定义配色方案的源颜色。输入的颜色将用于生成一套方案，为你提供互补的色调，使方案更加完整。</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-03-11T10:02:23.781Z"},{"pageContentChunkId":"c197007f-6694-4a85-bf5d-265ff2a349e6","pageContentChunkCanonId":"a8864815-df64-4ed3-83a5-10e8fc8f4b53","htmlValue":null,"footer":"<p>品牌属性（左）示例，可用于生成并应用动态颜色方案（右）</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fkufimufa-3p-brand_custom.png?alt=media&token=c7d79eca-5240-49f5-a6ab-fece2e065074","imageUrlFife":"https://lh3.googleusercontent.com/20rsancFoe-o-GeacNloK_tKMfa2E1ZYsJCkN4OqICgjrodGJXqXhWOw6Moan2UooPZ8LzfgmtCCHY-7gsBCmP64yPNUYPIoul4u4GmvHIS9=s2048","imageHeight":1818,"imageWidth":2048,"altText":"四个色板首先单独显示，然后作为 Material Theme Builder UI 的输入。随后，颜色灵感与字体组合成植物品牌应用的最终 UI。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-03-11T10:02:23.781Z"}]},{"pageContentBlockId":"6f161db5-09ac-4f68-8217-36867bdeb988","pageContentBlockCanonId":"ca0d7d0e-8e30-4e48-bcae-f5d8adef5f9a","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"ebb5b3d0-a9a2-4c25-a213-ece9cbea968d","pageContentChunkCanonId":"f773e230-a199-47b6-8935-765ca3c2ef96","htmlValue":"<h3>颜色角色</h3>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2021-10-06T13:04:49.659Z"}]},{"pageContentBlockId":"3b9cb95b-8b34-4e14-875d-7386333beede","pageContentBlockCanonId":"b8e03918-5d2a-4bc6-8cfa-508b8c81dceb","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"450e5022-53fa-42ed-8a6a-02602ec0c45a","pageSectionCanonId":"a1179362-b276-4c5f-9323-07b46bef8110","contentChunks":[{"pageContentChunkId":"c1e0a04c-7254-4f42-af31-a63dc15917e9","pageContentChunkCanonId":"b06a415e-e566-45f6-ab2d-7e41c417e9db","htmlValue":"<p class=\"normal\" id=\"isPasted\">根据在 UI 中的用途，关键颜色会被分配角色，映射到组件中的各个元素。五个带有角色分配的基本颜色组分别是：</p><ul><li>Primary（主色）</li><li>Secondary（辅助色）</li><li>Tertiary（第三色）</li><li>Neutral</li><li>Neutral Variant</li></ul><p class=\"normal\">输入的颜色会生成一个色调调色板，用于填充所需的各种颜色角色，例如 primary、on-primary 和 primary container。<a href=\"/m3-material-zh/m3/pages/color-roles/\">进一步了解如何使用颜色角色</a></p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":null,"videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2024-04-02T13:13:20.888Z"},{"pageContentChunkId":"bacdd61c-9805-402c-9151-66eeebbe3908","pageContentChunkCanonId":"a4a19e8b-5f66-4505-9036-5559aff314a7","htmlValue":null,"footer":"<p>Plant Care UI 中的颜色角色映射到设计令牌的示例</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fkufivgty-3p-brand_color-mapping.png?alt=media&token=0e59e0ca-f5b1-4bdf-ad17-42382f54d227","imageUrlFife":"https://lh3.googleusercontent.com/kqa_LNBbbacJHfLL5ADPfJIcqHAeVIz3KMqy2PFGFHqQz5ir51Ww0APxKJt5J7EfRehqidtv4kxSlvmx5Je3A5jmH_y_jXbHWGIwsGyTINBP=s1352","imageHeight":998,"imageWidth":1352,"altText":"移动端 UI 图示，带图注标明特定元素被映射到特定颜色的位置，例如 on-surface 或 primary。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode"