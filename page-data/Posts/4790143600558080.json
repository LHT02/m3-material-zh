_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/2c080c8e110016732eb8fdf4fbdb86213052dc9c88032e70d2060705a06ae486fcb1ba5438ba3e69de3e9097fe6309f0459f3bf2a655f3f6f853903664fafe29","height":900,"url":"https://lh3.googleusercontent.com/IzUbig5u1Ii81cxaTwwYingMmA2tGSs43STzsgs7HnasBi_ZQzjNO4N5_60m_7p62co-s8bYrPpQJ8YDkSrB8QEUSCf9_kq4qcNylTYK_Yv76ZJVXGQa","width":1800},"link":{"aria_label":null,"href":"/blog/material-design-awards-2021","label":"2021 Material Design Awards","open_new_window":false},"section":"Material Blog","title":"2021 Material Design Awards"},"document_id":5707358076141568,"document_label":null,"repo_id":"mio-example"}]},"document_id":"4790143600558080"}