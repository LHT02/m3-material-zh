9-9bdd-369956b4543a","htmlValue":"<p><strong>你能获得：</strong></p><p id=\"isPasted\">✓ 符合无障碍要求的颜色<br />✓ 现成的基线配色方案<br />✓ 不会破坏 M2 应用的颜色<br />✓ 便于日后升级到动态颜色</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T18:06:59.326Z"},{"pageContentChunkId":"35c8c525-3495-424b-af36-7a77860f800f","pageContentChunkCanonId":"ad50663b-88f4-469e-93d9-97c7728dd1df","htmlValue":"<p><strong>你<em>无法</em>获得：</strong></p><p id=\"isPasted\">✗ 个性化的颜色<br />✗ 会根据用户壁纸或应用内内容而改变的颜色<br />✗ 用户可控制的对比度设置</p>","footer":null,"imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T18:06:59.326Z"}]},{"pageContentBlockId":"db45d1f3-9926-4339-aefb-bfcf4cf39111","pageContentBlockCanonId":"534d5625-9560-41c6-b9b9-f234d040d4a6","isHidden":true,"isSqueezed":false,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"d73da210-bae0-409d-85cf-e07f4da64d51","pageContentChunkCanonId":"4d1c08a0-13d5-4a13-b0ee-1052ada4b230","htmlValue":"<p><strong>使用基线方案的产品</strong>（截至 2023 年 10 月）</p><ul><li>Maps</li><li>Search App (Android)</li><li>Home</li><li>Play Store</li><li>Primitives</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-23T13:10:19.830Z"}]},{"pageContentBlockId":"8681e308-c601-40ad-88d0-28bcf4272359","pageContentBlockCanonId":"0ec069b0-9d7f-477c-b952-25f87dc9d225","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"fb47eee5-6cd9-48dc-aad3-f5cb3d8485a0","pageContentChunkCanonId":"fa929b6c-5621-40cb-b71d-9612bdc89028","htmlValue":"<h3 id=\"isPasted\"><strong>在以下情况下使用静态（基线）颜色</strong></h3><ul><li>你尚未准备好实现动态颜色（不过等你准备好时，切换起来也很容易）</li><li>你的产品正在从 M2 迁移，希望在不破坏应用的情况下获得 M3 特性</li><li>你的产品面向企业用户，个性化颜色或用户可控的对比度设置对他们并无助益</li><li>你的产品是为 iOS 构建的</li></ul><p><br /></p><p><strong id=\"isPasted\">选择基线方案？</strong><a href=\"/m3-material-zh/m3/pages/static/baseline\"><strong>开始使用基线颜色进行设计</strong></a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2023-10-09T19:53:04.106Z"}]},{"pageContentBlockId":"a2758738-3c3a-4a3a-bbc7-7181e902cc4f","pageContentBlockCanonId":"00d5b65d-dd10-42c5-baaf-cd129cc2c1b5","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"43345f53-a3c5-45b3-ba29-7159f0f3ba63","pageSectionCanonId":"4bbd1052-f90e-48e4-8325-f57f86e16c31","contentChunks":[{"pageContentChunkId":"0d2617e8-2aee-4789-aed3-9f60436766cf","pageContentChunkCanonId":"e605e09f-3e26-44b2-8e18-eddda1e80673","htmlValue":"<h2>动态颜色</h2><p>动态颜色会基于特定的来源颜色自动创建一个符合无障碍要求的配色方案。</p><p>由于 UI 最终可能面对各种不同的来源颜色，最好先使用基线配色方案进行设计，以确保正确的颜色角色映射到产品中正确的组件上。你可以使用 <app-froala-tooltip-element description=\"Material Theme Builder (MTB) is a Figma plugin that allows markers to emulate the color extraction process for dynamic color and create custom tonal schemes. \" link-label=\"Get the MTB\" link-url=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" should-open-link-in-new-tab=\"true\">Material Theme Builder</app-froala-tooltip-element> 查看你的 UI 设计稿在各种来源颜色下的外观，并按需进行调整。</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp"