%2Fimages%2Fm4k2caip-6.png?alt=media&token=74e73df8-b55e-48d2-9b70-202bb5d89a53","imageUrlFife":"https://lh3.googleusercontent.com/DeZMSmblekT7CJla66TuXekJ2mnhrENpzRb1Yjzusj0ZDNB553w6Jhq_gotbSMiyd5AcLLLC5Gn8w4W9EUYuzfYuf5gPsOm06ADeRr08Ly8=s656","imageHeight":1230,"imageWidth":656,"altText":"Gmail 的手机截图。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.304Z"}]},{"pageContentBlockId":"55c24d15-cef9-434e-b28f-8ca9ebc46c97","pageContentBlockCanonId":"02d4877f-d425-48c4-be27-cf9b8c4832a9","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"b951a9ff-fdc9-433b-bce7-ab4b4e9682d0","pageContentChunkCanonId":"8f5b12c9-44f4-4439-ad56-c1b7a41128ca","htmlValue":"<h2>使用用户生成颜色进行设计</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.186Z"}]},{"pageContentBlockId":"e41a1f53-d0f4-4fea-b41e-86fc1e4c40aa","pageContentBlockCanonId":"8171346e-1403-4bb5-aebc-9068806af6a8","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"e458bd50-e319-4cbd-9be8-02aefb324e42","pageContentChunkCanonId":"897d12d9-cf16-45b9-b397-aa6f7d2ef1a0","htmlValue":"<p>由于最终颜色会在每位用户的个人设备上动态生成，<strong>在你的设计中理解并应用系统的<app-froala-tooltip-element description=\"Color roles are assigned to UI elements based on emphasis, container type, and relationship with other elements. This ensures proper contrast and usage in any color scheme.\" link-label=\"More on color roles\" link-url=\"/m3/pages/color-roles\" should-open-link-in-new-tab=\"true\">颜色角色</app-froala-tooltip-element></strong>，比使用特定的十六进制值更为重要。</p><p>最简单的方法是使用 <app-froala-tooltip-element description=\"Material Theme Builder (MTB) is a Figma plugin that allows markers to emulate the color extraction process for dynamic color and create custom tonal schemes. \" link-label=\"Get the MTB\" link-url=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" should-open-link-in-new-tab=\"true\">Material Theme Builder</app-froala-tooltip-element> 生成的配色方案，专注于将颜色角色应用到你的设计中，而不是使用特定的十六进制值。然后，你可以使用 Material Theme Builder 测试设计在各种潜在的用户生成颜色选项下的表现。</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.311Z"}]},{"pageContentBlockId":"7da5321e-a15c-4488-b2c2-1fe5030ea8b1","pageContentBlockCanonId":"8de327ec-34cd-475f-8931-2a8848d55485","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"743404a6-24e5-4f89-85f9-941fed23be3b","pageContentChunkCanonId":"0a84dbda-0ba6-4573-8624-89bc7fc7a81f","htmlValue":"<h3 id=\"isPasted\">在新设计文件中使用 Material 颜色角色</h3><p id=\"isPasted\"><strong>首先，使用 Material Theme Builder 创建一个新主题，以获取颜色角色</strong></p><ol id=\"isPasted\"><li>打开你的 Figma 文件。在 Figma 工具栏中选择 <strong>Resources</strong> 按钮</li><li>找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder plugin</a> 并选择 <strong>Run</strong>。此时会打开一个插件对话框，显示默认配色方案，包括 Core 颜色和 Extended 颜色。</li><li>打开插件的 <strong>Settings</strong>（对话框右下角的齿轮图标），并勾选 <strong>New theme color diagram</strong> 和 <strong>Generate State Layers</strong> 两个复选框。这将为你的品牌配色方案创建一个直观的可视化，并生成设计交互所必需的状态层。<a href=\"/m3-material-zh/m3/pages/interaction-states/state-layers\" rel=\"noopener noreferrer\" target=\"_blank\">进一步了解状态层</a></li><li>退出设置界面</li><li>打开对话框顶部的 Current Theme 下拉菜单，并选择 <strong>+ ADD NEW THEME</strong></li><li>为你的主题起一个简短的名称（该名称将成为你的颜色角色在 Figma 中的前缀）</li><li>选择 <strong>ADD THEME</strong></li><li>在选中 <strong>Custom</strong> 的情况下，选择 <strong>Primary（主色）</strong>。此时会打开一个对话框，提示你选择一个自定义来源颜色。</li><li>输入颜色的十六进制（Hex）值，然后点击 <strong>Apply</strong>。这将生成一个完整的配色方案。</li><li id=\"isPasted\">在对话框顶部的 Current Theme 下拉菜单中，选择你的主题</li><li>选择文件中的画框（frame）或组件，然后点击对话框右下角的 <strong>Swap</strong>。这会自动更新所有 M3 Design Kit 组件的颜色。</li></ol><p><br /></p><h3>将颜色角色应用到现有文件或 M3 Design Kit 组件</h3><p><strong>首先，将颜色角色导入你的文件</strong></p><ol><li id=\"isPasted\">从你的 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder</a> 文件中复制所需配色方案的颜色图示，并将其粘贴到你的文件中（这会使颜色角色作为本地样式显示在屏幕右侧的 Design 面板中）</li></ol><p><strong>将 M3 Design Kit 组件中的颜色替换为你偏好的颜色</strong></p><ol><li>在 Figma 工具栏中选择 <strong>Resources</strong> 按钮。</li><li>找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder plugin</a> 并选择 <strong>Run</strong>。此时会打开一个插件对话框，显示默认配色方案，包括 Core 颜色和 Extended 颜色。</li><li>在对话框顶部的 Current Theme 下拉菜单中，选择你的配色方案</li><li>选择文件中需要更新颜色的画框或 M3 Design Kit 组件，然后点击对话框右下角的 <strong>Swap</strong>。这会自动将它们的颜色从基线颜色更新为你所选配色方案的颜色</li></ol><p><strong>然后，更新其余所有非颜色角色相关的颜色</strong></p><ol><li>通过全选并逐一查看屏幕右侧 Design 面板中的 Selection colors，手动更改任何十六进制值或非颜色角色相关的颜色样式</li><li>任何不以你所选配色方案名称开头的颜色都需要替换为相应的颜色角色</li><li>将鼠标悬停在 Design 面板中某个非颜色角色相关的颜色行上，然后选择 <strong>Style</strong> 图标（四个圆点）。此时会打开一个选择对话框。</li><li>搜索你的配色方案名称以查看颜色角色</li><li>选择与该颜色用例最匹配的基于颜色角色的颜色（关于在何处使用何种颜色，请参阅<a href=\"/m3-material-zh/m3/pages/color-roles\">颜色角色</a>了解更多信息），然后选择 <strong>Use style</strong> 将其应用到所选对象</li><li>重复上述操作，直到文件中所有非颜色角色相关的颜色都已被替换为颜色角色</li></ol><p><br /></p><h3 id=\"isPasted\">试用你的设计在动态颜色下的外观</h3><ol id=\"isPasted\"><li id=\"isPasted\">在 Figma 工具栏中选择 <strong>Resources</strong> 按钮。</li><li>找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" rel=\"noopener noreferrer\" target=\"_blank\">Material Theme Builder plugin</a> 并选择 <strong>Run</strong>。此时会打开一个插件对话框，显示默认配色方案，包括 Core 颜色和 Extended 颜色。</li><li>选择 Dynamic</li><li>添加一张图片，或选择 <strong>Shuffle</strong> 图标以获取随机的来源颜色</li><li>选择文件中你希望以动态颜色查看的画框或组件，然后点击对话框右下角的 <strong>Swap</strong>。这会自动将它们的颜色更新为用户生成的动态颜色。</li><li>使用一系列颜色重复上述操作，以感受你的产品在不同用户的设备上的外观</li></ol><p><br /></p><p><strong>需要对配色方案进行调整？请查看<a href=\"/m3-material-zh/m3/pages/advanced/overview\">高级自定义</a></strong></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.317Z"}]},{"pageContentBlockId":"a2b85ecc-b29e-42da-9f76-1971524e62b3","pageContentBlockCanonId":"930fda61-3471-433c-828d-3f4c031f934c","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"15d80dcc-52b7-4443-ba54-da54fe2b4bf7","pageContentChunkCanonId":"eb8d6c0a-64a6-4322-90ca-ae181033e52c","htmlValue":"<h2>使用用户生成颜色进行开发</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-05-08T13:30:10.187Z"}]},{"pageContentBlockId":"74116e34-de58-446b-b05e-a439f19c48f4","pageContentBlockCanonId":"602fc8d8-6bb7-4b0c-a652-2aa8e7b6a5bb","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b729a44b-ae1f-409e-9887-4a500b282eaf","pageSectionCanonId":"7ba9849e-a552-4c37-93c6-1278316a4547","contentChunks":[{"pageContentChunkId":"691397ec-3182-4c13-8a46-3abc58ea9f30","pageContentChunkCanonId":"0b033e4c-efcf-499f-b100-9c92ef9db2e1","htmlVa