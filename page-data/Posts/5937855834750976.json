ge"},"published_date":"2022-12-01T13:00:00","slug":"24-hour-clock-design-research","subtitle":"设计与研究携手打造无障碍且用户友好的时间选择器","title":"24 小时制时钟的设计挑战","up_next":{"items":[{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/7988151124048178cc96306b65796531d65b3bf79d709446cfdcdaff03cc9ecb36e2ab5c4413698a3d6a4ad8146a1bbee56e136527fb9e42c8964a1f29300634","height":2160,"url":"https://lh3.googleusercontent.com/5J71k4ejdHyRkjMdbUf6nE02HknqhTkuyHIV5QcLzRbnrF0YiPd2W23GGQj-zKDsU4B5TVrrpVgR3MB8FwDbv-O45ai27Zi9fXHEfCB1ltzj3tyDIxo","width":3840},"link":{"aria_label":null,"href":"https://material.io/blog/material-io-redesign","label":"Magic, utility, and redesigning Material.io","open_new_window":false},"section":"Material Blog","title":"Magic, utility, and redesigning Material.io"},"document_id":4637395882475520,"document_label":null,"repo_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/431dfac6c5ce89665d484592b44c8066d4b009ee23e07ac7f8e6295313ad9ece46f3b390755cd81685be2f44f2ea784fbe82eefdf5fdd401d8430fc8a4b543cf","height":1890,"url":"https://lh3.googleusercontent.com/hwCFDEfbHlMM92sX1YWje3r5Df9KOiUg-xrF9cZf4YFka-4O83DEv1wYT38uoV509-Oet5dYl0jTXsriDvfN5sTjlLlLbvIsH2vhJNgaZXg3ZCXcwA","width":2892},"link":{"aria_label":null,"href":"/blog/material-3-figma-design-kit","label":"Introducing the M3 design kit for Figma","open_new_window":false},"section":"Material Blog","title":"Introducing the M3 design kit for Figma"},"document_id":4521237334327296,"document_label":null,"repo_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/10670050668c02a15305405869d10261ae9184c4b9943da19db1f77dfec09cbadff181927e3ee1b025e024736848d2c53950c779e44a033489d2f68c57607b44","height":900,"url":"https://