pdatedTimestamp":"2026-02-11T21:53:46.525Z"}]},{"pageContentBlockId":"4e2da807-6637-4e4b-933d-7275902146a1","pageContentBlockCanonId":"b5a485b5-ee5f-4890-b7a2-ead284121e37","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"e48aa166-2093-4873-a016-98477e1c3b67","pageSectionCanonId":"17452dce-4177-421e-95cd-2b37ba113fa4","contentChunks":[{"pageContentChunkId":"893328b4-9266-4b74-82d9-d4eb4c68dff7","pageContentChunkCanonId":"96346416-b79e-4b8d-867c-f33a2a5a2add","htmlValue":"","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":"designSystems/20543ce18892f7d9","libraryModuleType":"COLOR","moduleConfigurationOverrides":{"tokenSets":["Color schemes","Palettes"],"contextTags":["None","Medium contrast","Default","High contrast","3P","Android","Dark","Light"],"hideSearchField":false,"hideVersionName":true},"contentChunkType":"RESOURCE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.526Z"}]},{"pageContentBlockId":"cd45e276-5b02-4562-906f-6d490e1a6c57","pageContentBlockCanonId":"fd2e9628-c023-4f2c-aa43-7e0e67aa3428","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"e18b0c9f-6ff7-42c8-bb93-078bfba6292a","pageSectionCanonId":"17452dce-4177-421e-95cd-2b37ba113fa4","contentChunks":[{"pageContentChunkId":"447df3d6-2086-4f39-b67a-87b4421b5ed3","pageContentChunkCanonId":"8b3bb7c2-e52b-4d63-8952-2ffdc045af05","htmlValue":"<h2>使用基线进行设计</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.526Z"}]},{"pageContentBlockId":"07182427-1973-4b48-9b6f-658c9f6f6d9e","pageContentBlockCanonId":"e95ddd2b-90af-45b1-9b88-f50f56205c51","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"e18b0c9f-6ff7-42c8-bb93-078bfba6292a","pageSectionCanonId":"17452dce-4177-421e-95cd-2b37ba113fa4","contentChunks":[{"pageContentChunkId":"33aa3bb3-1e37-4e37-a020-882859336232","pageContentChunkCanonId":"8e2ddbe5-01b6-4d2f-ae91-9b45647de150","htmlValue":"<h3>在新建设计文件中使用 Design Kit 和 M3 基线颜色</h3><ol class=\"decimal\"><li><p>创建你的 Figma 文件。在 Assets 面板中启用 <a href=\"https://www.figma.com/community/file/1035203688168086460\" target=\"_blank\">M3 Design Kit</a>。</p></li><li><p>使用设计套件中的 Material 组件构建屏幕和布局</p></li><li><p>将 M3 基线颜色角色应用于自定义组件和 UI 元素：将鼠标悬停在屏幕右侧 Design 面板中该元素的颜色属性上，然后选择 <strong>Style</strong> 图标（四个点）。这会打开一个选择对话框。</p></li><li><p>搜索 \"M3\" 以查看基线颜色角色</p></li><li><p>选择与用例和意图最匹配的基线颜色角色（关于在何处使用何种颜色的更多信息，请参阅 <a href=\"/m3-material-zh/m3/pages/color-roles\" target=\"_self\">Color roles</a>）</p></li><li><p>重复上述步骤，直到所有自定义元素都使用 M3 基线颜色角色</p></li></ol><p></p><h3>将基线颜色应用到现有文件</h3><p><strong>首先，将 M3 基线颜色导入你的文件</strong></p><ol class=\"decimal\"><li><p>打开你的 Figma 设计文件。选择 <strong>Actions</strong> 菜单（或 Ctrl/Command+K）。 </p></li><li><p>找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\">Material Theme Builder 插件</a>并选择 <strong>Run</strong>。这会打开一个插件对话框，其中显示默认配色方案，包括 Core 颜色和 Extended 颜色。</p></li><li><p>打开插件的 <strong>Settings</strong>（对话框右下角的齿轮图标），勾选 <strong>Generate State Layers</strong> 复选框。这可确保为设计交互所需的状态层提供颜色。 <a href=\"/m3-material-zh/m3/pages/interaction-states/state-layers\" target=\"_blank\">进一步了解状态层</a></p></li><li><p>退出设置。</p></li><li><p>在对话框顶部的 Current Theme 下拉菜单中，选择 <strong>Baseline。</strong></p></li><li><p>选择文件中的画框或组件，然后点击对话框右下角的 <strong>Swap</strong>。这会自动更新所有 M3 Design Kit 组件的颜色。</p></li></ol><p><strong>然后，更新所有剩余的非 M3 颜色样式</strong></p><ol class=\"decimal\"><li><p>手动更改任何十六进制值或非 M3 颜色样式：全选所有内容，然后逐一查看屏幕右侧 Design 面板中的 Selection colors。</p></li><li><p>任何不以 \"M3\" 开头的颜色都需要替换为相应的基线颜色。</p></li><li><p>将鼠标悬停在 Design 面板中的非 M3 颜色行上，然后选择 <strong>Style</strong> 图标（四个点）。这会打开一个选择对话框。</p></li><li><p>搜索 \"M3\" 以查看基线颜色角色。</p></li><li><p>选择与该颜色用例最匹配的基线颜色角色（关于在何处使用何种颜色的更多信息，请参阅 <a href=\"/m3-material-zh/m3/pages/color-roles\" target=\"_self\">Color roles</a>），然后选择 <strong>Use style</strong> 将其应用到所选对象。</p></li><li><p>重复上述步骤，直到文件中所有非 M3 颜色都已替换为 M3 基线颜色角色。</p></li></ol><p><strong>需要调整配色方案？请参阅 </strong><a href=\"/m3-material-zh/m3/pages/advanced/overview\" target=\"_self\"><strong>高级自定义</strong></a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.595Z"}]}]},{"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","name":"自定义品牌","position":1,"pageId":"589c6d17-3ef6-475d-8d28-dcd4b443d617","pageCanonId":"247d635f-924c-4e83-8383-94965fe769e2","isVisible":true,"contentBlocks":[{"pageContentBlockId":"43697509-d37c-4032-bc63-552c6c2b85c9","pageContentBlockCanonId":"42caef36-c5b0-4b50-977a-a3e81e453396","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"7ef758b6-1192-4b1f-a6f7-f749c870b6e2","pageContentChunkCanonId":"8b127ee5-2e3e-40c1-8988-05af7c4dc2d0","htmlValue":"<p>在基于品牌的静态配色方案中，颜色由你的团队手工挑选，以契合产品的品牌色。基于品牌的配色方案完全由你的团队创建和维护，因此这种方式需要投入更多时间和精力。</p><p id=\"isPasted\"><strong>使用品牌配色方案时，最终用户会看到</strong></p><ul><li>采用静态颜色的无障碍界面</li><li>“看起来与品牌相符”的产品</li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.600Z"}]},{"pageContentBlockId":"3ed47089-cfab-4166-9d2b-98db38824a9a","pageContentBlockCanonId":"d17ad6d1-7fd4-4081-9892-2f4fdb1b7945","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"4bb87e78-2f68-4804-bd69-e8d434d317cc","pageContentChunkCanonId":"4ff48079-d323-41e8-b315-dd81e6082936","htmlValue":null,"footer":"<p>这个示例冥想应用使用由其品牌色创建的静态配色方案。</p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgm3sandbox%2Fimages%2Fln4ilrfy-brand-baseline.png?alt=media&token=7831c3fc-1a36-4aa2-a583-65474ec97d3d","imageUrlFife":null,"imageHeight":1200,"imageWidth":2048,"altText":"左：旋转的红色、品红与绿色球体，代表冥想应用 logo。中：由球体中的三种品牌色创建的配色方案。右：以红色、品红和绿色 UI 呈现的冥想应用屏幕。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.527Z"}]},{"pageContentBlockId":"78a8061c-bc82-4e6d-85f2-493a445d36e9","pageContentBlockCanonId":"c752797c-5c9b-440a-8010-312f8c07d225","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"e15b85b1-583f-4602-9b3d-1d272d6ca084","pageContentChunkCanonId":"08f2b81e-4b2d-4676-8df9-16a956f0ca50","htmlValue":"<h2>创建自定义品牌配色方案</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.527Z"}]},{"pageContentBlockId":"ed1859d4-79cf-4b4e-8cb5-26dd6b929e97","pageContentBlockCanonId":"f658c43a-f2d8-43bc-a9a9-75cdb052cd3e","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"150da655-d6cd-4bd2-9415-d42074a000ff","pageContentChunkCanonId":"9560b6fe-490f-494f-81b0-4a120fc116e8","htmlValue":"<ol class=\"decimal\"><li><p>打开你的 Figma 设计文件。选择 <strong>Actions</strong> 菜单（或 Ctrl/Command+K）。 </p></li><li><p>找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\">Material Theme Builder 插件</a>并选择 <strong>Run</strong>。这会打开一个插件对话框，其中显示默认配色方案，包括 Core 颜色和 Extended 颜色。</p></li><li><p>打开插件的 <strong>Settings</strong>（对话框右下角的齿轮图标），勾选 <strong>New theme color diagram</strong> 和 <strong>Generate State Layers</strong> 两个复选框。这将为你的品牌配色方案创建一个实用的可视化图表，并生成设计交互所必需的状态层。 <a href=\"/m3-material-zh/m3/pages/interaction-states/state-layers\" target=\"_blank\">进一步了解状态层</a></p></li><li><p>退出设置。</p></li><li><p>打开对话框顶部的 Current Theme 下拉菜单，选择 <strong>+ ADD NEW THEME。</strong></p></li><li><p>为主题起一个简短的名称（该名称将成为你的颜色角色在 Figma 中的前缀）。</p></li><li><p>选择 <strong>ADD THEME。</strong></p></li><li><p>在选中 <strong>Custom</strong> 的情况下，选择 <strong>Primary（主色）</strong>。这会打开一个对话框，提示你选择自定义源颜色。</p></li><li><p>输入品牌色的 Hex 值，然后点击 <strong>Apply</strong>。</p></li></ol><p>这将生成一个完整的自定义配色方案。你可以按原样使用该方案，也可以重复步骤 5 和 6，为 Secondary（辅助色）、Tertiary（第三色）、Error、Neutral 和 Neutral Variant 颜色设置自定义源颜色。</p><p><strong>想进一步调整品牌配色方案？请参阅 </strong><a href=\"/m3-material-zh/m3/pages/advanced/overview\" target=\"_self\"><strong>高级自定义</strong></a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.606Z"}]},{"pageContentBlockId":"a8d8149a-f737-4cc2-b656-5a51b0f5cca8","pageContentBlockCanonId":"150e4170-a857-4b84-ab5f-9bf1645fe1be","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"9f6021f0-3420-4922-869b-70fdc3dc8058","pageContentChunkCanonId":"c6f05656-08a3-4738-9615-0a9a5a123f20","htmlValue":"<h2>使用品牌色进行设计</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.528Z"}]},{"pageContentBlockId":"d012a0dd-d1ef-4c52-a739-cdac47301c3c","pageContentBlockCanonId":"41079335-27ea-4e9e-af61-ebb8372fda09","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"82725266-7e09-4d32-a256-82409440935f","pageContentChunkCanonId":"37272f6c-c9d0-4d4b-935c-1b1f9e352bfc","htmlValue":"<h3 id=\"isPasted\">在新建设计文件中使用品牌色</h3><ol><li>创建你的 Figma 文件。在 Assets 面板中启用 <a href=\"https://www.figma.com/community/file/1035203688168086460\" target=\"_blank\" rel=\"noopener noreferrer\">M3 Design Kit</a>。</li><li>复制你的配色方案颜色图表并粘贴到文件中（这会使颜色角色作为你的本地样式的一部分，出现在屏幕右侧的 Design 面板中）</li><li id=\"isPasted\">将品牌颜色角色应用于自定义组件和 UI 元素：将鼠标悬停在屏幕右侧 Design 面板中该元素的颜色属性上，然后选择 <strong>Style</strong> 图标（四个点）。这会打开一个选择对话框。</li><li>搜索你的主题名称，以查看品牌颜色角色</li><li>选择与用例和意图最匹配的品牌颜色角色（关于在何处使用何种颜色的更多信息，请参阅 <a href=\"/m3-material-zh/m3/pages/color-roles\">Color roles</a>）</li><li>重复上述步骤，直到所有自定义元素都使用你的品牌颜色角色</li></ol><p><br /></p><h3>将品牌色应用到现有文件或 M3 Design Kit 组件</h3><p><strong>首先，将品牌色导入你的文件</strong></p><ol><li>复制你的配色方案颜色图表并粘贴到文件中（这会使颜色角色作为你的本地样式的一部分，出现在屏幕右侧的 Design 面板中）</li></ol><p><strong>将 M3 Design Kit 组件中的颜色替换为你的品牌色</strong></p><ol><li id=\"isPasted\">找到 <a href=\"https://www.figma.com/community/plugin/1034969338659738588/material-theme-builder\" target=\"_blank\" rel=\"noopener noreferrer\">Material Theme Builder 插件</a>并选择 <strong>Run</strong>。这会打开一个插件对话框，其中显示默认配色方案，包括 Core 颜色和 Extended 颜色。</li><li id=\"isPasted\">在对话框顶部的 Current Theme 下拉菜单中，选择你的配色方案</li><li>选择文件中需要更新颜色的画框或 M3 Design Kit 组件，然后点击对话框右下角的 <strong>Swap</strong>。这会自动将其颜色从基线颜色更新为你的品牌色</li></ol><p><strong>然后，更新所有剩余的非品牌颜色样式</strong></p><ol><li>手动更改任何十六进制值或非品牌颜色样式：全选所有内容，然后逐一查看屏幕右侧 Design 面板中的 Selection colors</li><li>任何不以你的主题名称开头的颜色都需要替换为相应的品牌色</li><li>将鼠标悬停在 Design 面板中的非品牌颜色行上，然后选择 <strong>Style</strong> 图标（四个点）。这会打开一个选择对话框。</li><li>搜索你的主题名称，以查看品牌颜色角色</li><li>选择与该颜色用例最匹配的品牌颜色角色（关于在何处使用何种颜色的更多信息，请参阅 <a href=\"/m3-material-zh/m3/pages/color-roles\">Color roles</a>），然后选择 <strong>Use style</strong> 将其应用到所选对象</li><li>重复上述步骤，直到文件中所有非品牌颜色都已替换为品牌颜色角色</li></ol><p><br /></p><p><strong>需要调整配色方案？请参阅 <a href=\"/m3-material-zh/m3/pages/advanced/overview\">高级自定义</a></strong></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:13.659Z"}]},{"pageContentBlockId":"6f8b1c72-70ec-414c-af21-9bdabab71fd7","pageContentBlockCanonId":"1ce3bfe6-d65a-448d-b148-7f0c8c5c284e","isHidden":false,"isSqueezed":true,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"616588e8-00e1-4dfe-a955-1be92b62f3c4","pageContentChunkCanonId":"a6c2a8c2-7e85-4361-a0ff-ec27397228fb","htmlValue":"<h2>使用品牌色进行开发</h2>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.528Z"}]},{"pageContentBlockId":"58432d60-040c-4567-83ef-577119734c6a","pageContentBlockCanonId":"0e5bca90-d760-465a-955b-b2c8e81d1773","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"6710235a-2502-4994-a822-1d72c0eae397","pageSectionCanonId":"3c20ab60-e832-4f96-8c51-b72f6edbedcd","contentChunks":[{"pageContentChunkId":"9f5e2426-52b7-4bca-98f7-e93327403a43","pageContentChunkCanonId":"a0494489-2875-410a-9b48-511e8ecfaccf","htmlValue":"<ul><li>从 Material Theme Builder 导出你的品牌配色方案（支持 Jetpack Compose、Android Views、Flutter、Web，或导出为 JSON 文件）</li><li>Android：<a href=\"https://developer.android.com/develop/ui/views/theming/themes#CustomizeTheme\" rel=\"noopener noreferrer\" target=\"_blank\">自定义默认主题</a></li></ul>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-02-11T21:53:46.618Z"}]}]}]}