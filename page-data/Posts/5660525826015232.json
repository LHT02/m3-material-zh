l,"href":"/blog/how-to-make-text-more-accessible","label":"How to make your text more accessible","open_new_window":false},"section":"Material Blog","title":"How to make your text more accessible"},"document_id":4618859863736320,"document_label":null,"repo_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/0fdd6e585c167efbb12841bc6d4196ffca44662c6928e583881041686d5ddedc14f8ae7ee78f05986c156c069a3e8b466c4909eee1c0a58ddd521629bb9dc38c","height":532,"url":"https://lh3.googleusercontent.com/t53yjKYzXLUMbZdsIWnTsrbhcSXAvj8xuldbHZwR1Z1H6nv8b3qjPmzlw57P7MvenJIOQO7Z_ICNiLqog2O4yrlvpsi4c-GLh7SFLfj7uljAN3AkU44","width":1064},"link":{"aria_label":null,"href":"/blog/google-fonts-pairing-figma","label":"You Asked for it—Here Are Some of Our Favorite Font Pairings","open_new_window":false},"section":"Material Blog","title":"You Asked for it—Here Are Some of Our Favorite Font Pairings"},"document_id":6482900635746304,"document_label":null,"repo_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/ef250c115c9abb21553b2ae258a6a5b479a01d9076358a9fa886d625396ef7bae8a2819235d4596d2cad99c1ee2291314f6c10832b12944621bdae1839205f69","height":934,"url":"https://lh3.googleusercontent.com/DfKWElr8WS_6nt0H5tL9wqqS7MfmwDUAWpbjF03HOT4ggF2wBPhSaGDDBes_QumgtN5ATWUK6br2IyqjAqQHab4HjjcYVmwh2hJmb1uXIDLw5khJuWA","width":1400},"link":{"aria_label":null,"href":"/blog/readex-pro-legibility-arabic-type-design","label":null,"open_new_window":false},"section":"Material Blog","title":"The Design of Readex Pro"},"document_id":5502041230278656,"document_label":null,"repo_id":"mio-example"}]},"document_id":"5660525826015232"}