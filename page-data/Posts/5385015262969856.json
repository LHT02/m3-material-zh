o_id":"mio-example"},{"collection_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/94ccae5400c110b59e0a752e8e67a0d911b9ba63ce354ed4a9411a36992dc5866db038eea65fabe74ccef3b02bf04cd09f852f40647e788c30d1ad4501fc7c20","height":561,"url":"https://lh3.googleusercontent.com/TeLZea0Z3_3eKsf_VU8bMh3Nn_HNmY3gLNl915hP41iP3X6ZVaCZt3UO-n1PbYVSIN09dOanns3gqMM5bJhJ3es1bJt5Zk7Zq_6F8Q","width":1000},"link":{"aria_label":null,"href":"/blog/android-material-motion","label":null,"open_new_window":false},"section":"Material Blog","title":"Building Beautiful Transitions with Material Motion for Android"},"document_id":5818737842978816,"document_label":null,"repo_id":"mio-example"}]},"document_id":"5385015262969856"}