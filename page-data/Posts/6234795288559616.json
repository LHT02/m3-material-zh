ion_id":"UpNextItems","document_content":{"image":{"file_path":"_f68a99ffe9144467a917320028f1ce3b_/_67af19389b5f45048ff0f3b64759ab41_/71b873d3c00ebb9924495297d956b10a057a9bc599d50a0cfd141fb26afb14acc4926b20bd9b32dc491db0aed5c5270426f2c9de5d18d5c70269dca2cefb3ed1","height":5001,"url":"https://lh3.googleusercontent.com/nUJTOrsF4VN5m2UMBM-J4lVD_W7wujCjUKLU8xH4wzikNlr6gdNRmga2okU7_lABELi5Ss3AjDyhSQc7Ay7vCZZ5gZahzB9Use8T3w","width":6251},"link":{"aria_label":null,"href":"/blog/design-material-theme-color","label":null,"open_new_window":false},"section":"Material Blog","title":"Designing a Material Theme: Color"},"document_id":5709731908550656,"document_label":null,"repo_id":"mio-example"}]},"document_id":"6234795288559616"}