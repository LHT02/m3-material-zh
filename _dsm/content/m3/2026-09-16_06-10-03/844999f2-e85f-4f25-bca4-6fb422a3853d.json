Z"}]},{"pageContentBlockId":"e7d48bfd-dfa0-429a-a4db-47ecf3201a3d","pageContentBlockCanonId":"ffe7c119-715b-46bc-8d8f-a9fc2f8a1fd8","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"6761f2e2-eafc-4993-a9c1-49e5365b4c62","pageContentChunkCanonId":"7567e3ef-ab61-4ce2-b461-91befcc05139","htmlValue":"<h3 id=\"isPasted\"><span style=\"white-space:pre-wrap\">把重要信息放在最前面</span></h3><p><span style=\"white-space:pre-wrap\" id=\"isPasted\">把最重要的信息放在开头，并让它易于理解。人们浏览而非逐字阅读，而且往往呈 F 形。在合理的情况下，尽量把最关键的信息移到句子的开头而不是结尾，放在结尾的信息可能被忽略或截断。</span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.163Z"},{"pageContentChunkId":"d34b3a0c-b377-41c5-bd52-6faf8d6aeac1","pageContentChunkCanonId":"6b97bdf7-685d-4125-b0da-7b554249f6e3","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">优先呈现最重要的信息</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53kfhk-2.png?alt=media&token=9c5b4033-2c38-4e18-85aa-5390cb29b785","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"来自 Google 应用的 3 条通知，标题中包含了通知的要点。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunk