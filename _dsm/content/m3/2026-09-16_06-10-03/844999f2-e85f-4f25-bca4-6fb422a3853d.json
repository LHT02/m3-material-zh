:null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"},{"pageContentChunkId":"1e012964-0aac-4aaf-a30b-f6f72b534169","pageContentChunkCanonId":"8d18c1cf-11c1-4087-b20a-7c999c6b4b83","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">用具体的信息抓住用户的注意力</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53l2ot-6.png?alt=media&token=4f5c0fd2-4f29-4a75-a5c6-0dafff49b473","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"田纳西州孟菲斯（Memphis, TN）的一条 Google 地图通知，针对用户所在的市中心位置进行了个性化定制。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"},{"pageContentChunkId":"45c73a4d-442a-492d-ac59-c6674a750bfb","pageContentChunkCanonId":"67622303-08d2-4731-bf0d-101d03d3dac4","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">不要泛泛而谈以致失去价值</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53l86v-7.png?alt=media&token=1da7ac0b-893b-4cbf-a2b7-0dac9c458820","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"田纳西州孟菲斯（Memphis, TN）的一条 Google 地图通知，内容面向整座城市，而非用户所在区域。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.165Z"}]},{"pageContentBlockId":"1a273823-0493-4f31-9ee0-1d6483c9a0e3","pageContentBlockCanonId":"f35c68c9-4f3c-4fdc-bc29-b3f3fb32ed98","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"152b1559-4621-436a-ace1-b0df6e9aa32e","pageContentChunkCanonId":"ecb5aaa9-8065-4c20-8447-e61606377fe2","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">避免动态文本</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">动态文本是由工程实现、会根据用户或上下文而变化的文字，例如在标题中加入用户的活动名称，或在用户于特定时间登录时显示“下午好”。<br /><br />尽量不要在通知中使用动态文本。它常常超出字符数限制，翻译后在标题中尤其如此。标题中被截断的文本不会展开，即使在可展开的通知中也是如此。如果必须在标题中使用动态文本，请尽量让它最多只搭配一个额外的词。创建一条符合字符数限制的备用通知，以备主通知放不下时使用。 </span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"},{"pageContentChunkId":"9e588b44-9721-49b6-b44f-78ee199e2a99","pageContentChunkCanonId":"35a93226-11de-4232-ba70-60de1ec9fcb6","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">把动态文本放在空间更充裕的通知正文中。如果要把动态文本放在标题中，请保持非常简短。</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lep9-8.png?alt=media&token=74837af0-9c5a-4440-ae6a-1b31f806484a","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"2 条通知：一条把动态文本放在正文中，另一条把动态文本放在标题中，且排版上始终保持简短。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"},{"pageContentChunkId":"5a71987a-9641-4653-b440-57c49ee6e95a","pageContentChunkCanonId":"c53a646e-ebfa-4957-84a5-f198ddc52e9d","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">不要把动态文本放在过长的通知标题中</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lk9g-9.png?alt=media&token=86ba3704-96ca-4aeb-9394-20ef722483e1","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"2 条通知的标题中包含动态文本，因过长而被截断。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.166Z"}]},{"pageContentBlockId":"71b4f319-6b7b-4124-b17e-56fd0cb2f67f","pageContentBlockCanonId":"61beeb67-aff8-4b9a-b9e2-14a7361254d5","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"df6f5715-0965-431d-acfe-9210cdc3d4fb","pageContentChunkCanonId":"c4a683ab-d65f-4537-bb0a-555f2c26a524","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">注意字符数</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">请将文本控制在以下建议的字符数内，以免被截断：</span></span></p><ul><li><span><span style=\"white-space:pre-wrap\">标题：&lt;29 个字符</span></span></li><li><span><span style=\"white-space:pre-wrap\">折叠正文：&lt;40 个字符</span></span></li><li><span><span style=\"white-space:pre-wrap\">展开正文：&lt;80 个字符；以折叠正文为基础进行扩展</span></span></li><li><span><span style=\"white-space:pre-wrap\">按钮：1-2 个按钮（每个 1-2 个词）</span></span></li></ul><p><span><span style=\"white-space:pre-wrap\"><br />在较新版本的 Android 上文本空间更大，但仍建议遵守这些限制，以防在较小的设备上被截断。</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.167Z"},{"pageContentChunkId":"7665dd8d-961c-4656-bedf-414a01e03f1c","pageContentChunkCanonId":"685630c2-73e2-4c71-bdb0-11481283ab81","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">让通知简短且信息密集</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53ls3l-10.png?alt=media&token=0975f21e-7522-40bb-acfb-28d8405bac9e","imageUrlFife":null,"imageHeight":600,"imageWidth":1352,"altText":"一条简短、相关且信息丰富的通知。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":2,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.167Z"}]},{"pageContentBlockId":"72d07eb3-510e-4f87-898e-88df2e6bc35e","pageContentBlockCanonId":"66c640f8-be77-4767-800b-de32a190875e","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"d0fe4fde-579e-4e63-ae14-f1864d3097ff","pageContentChunkCanonId":"422dea58-a42e-4cbd-a3eb-7d45b255d483","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">SMS 短信</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">SMS 可以在用户可能无法访问自己的 Google 账号时帮助他们收到消息。它仅用于重要或紧急的沟通。 <br /><br />SMS 在超过一定字符数后会被拆分成多条消息，导致成本增加。为避免这种情况，请遵守以下字符数限制：</span></span></p><ul><li><span><span style=\"white-space:pre-wrap\">拉丁语系语言：  &lt;160 个字符</span></span></li><li><span><span style=\"white-space:pre-wrap\">非拉丁语系语言：&lt;134 个字符</span></span></li></ul><p><span><span style=\"white-space:pre-wrap\"><br />如果需要翻译，请在消息描述中告知翻译人员字符数限制。 </span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"},{"pageContentChunkId":"79f209c3-fdf6-4124-baf6-9a394bdc25e2","pageContentChunkCanonId":"e229c888-2788-4fef-91e6-2e934a22bc91","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">SMS 短信应简短且重要</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53lzfr-11.png?alt=media&token=ea00548e-29b5-471d-8ac2-e47206c29e54","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"一条简短且对敏感信息进行了截断处理的 SMS 通知。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"},{"pageContentChunkId":"c2983e38-0679-4d8f-ae2d-30603312283b","pageContentChunkCanonId":"8a2d1dd1-8005-42ad-9b59-2edbf9af406d","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">不要使用完整的电子邮件地址或网站链接，以免占用文本长度</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53m528-12.png?alt=media&token=2be76632-4674-4858-b601-29bd9d4820df","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"一条过长且包含过多链接的 SMS 通知。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.168Z"}]},{"pageContentBlockId":"c4afb62b-e017-43a6-9f63-f115e3220056","pageContentBlockCanonId":"f59576bb-4f92-46a8-972b-db6af83b845c","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"f3d0f8fc-edfa-4b30-914a-b31a9146bec6","pageContentChunkCanonId":"3be21f6b-7328-4675-84ad-75717fb9cc16","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">谨慎使用 emoji</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">请克制地使用 emoji。很多 emoji 无法翻译，也无法被所有文化普遍理解。 </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">实验</span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"> 表明，面部和手势类 emoji 的效果优于普通 emoji，因为它们能讲出更好的故事。emoji 应当为内容增色，而不是取代内容。<br /><br />由于用户无法确定 emoji 表达的是我们在同情他们，还是我们在把自己的感受投射到他们身上，请不要用 emoji 来强调坏消息。在实验中，消极 emoji（例如皱眉脸、痛苦脸和疲惫脸）引发了强烈的负面反应。<br /><br />Z 世代为 emoji 增添了另一层文化含义：他们 </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><a href=\"https://www.textnow.com/blog/the-next-generation-of-emojis-gen-z-explained/\" target=\"_blank\" rel=\"noopener noreferrer\">发明了新的含义</a></span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">，这些含义超出了官方或字面上的 </span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\"><a href=\"https://emojipedia.org/\" target=\"_blank\" rel=\"noopener noreferrer\">定义</a></span></span><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">。</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:45.703Z"},{"pageContentChunkId":"f3217677-7e2c-4695-9c29-4d11ccb85910","pageContentChunkCanonId":"e6b23ab9-26e3-4543-952f-b9a84f21ba46","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">只在为消息增色时使用 emoji</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mcby-13.png?alt=media&token=22d82f3d-5533-472a-96cc-6407c99ca119","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"一条关于咖啡的通知，标题末尾带有一个咖啡 emoji。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DO","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.172Z"},{"pageContentChunkId":"a224120b-a638-4656-a16c-7f8a9e9dc653","pageContentChunkCanonId":"75dcd81c-bf1f-4898-99b2-b17e4a4c100b","htmlValue":null,"footer":"<p><span style=\"white-space:pre-wrap\">不要为消息添加消极情绪。不要用 emoji 代替文字。</span></p>","imageUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fgoogle-material-3%2Fimages%2Flw53mhmr-14.png?alt=media&token=faa05f8f-9a9c-4b5f-bb79-eed427812ccb","imageUrlFife":null,"imageHeight":600,"imageWidth":656,"altText":"一条关于上班路线交通拥堵的通知，使用了烦躁的 emoji。一条关于咖啡的通知，用咖啡 emoji 代替了“咖啡”一词。","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"IMAGE","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":null,"showBorderAroundMedia":null,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":"DON'T","captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2025-03-26T17:24:43.172Z"}]},{"pageContentBlockId":"f37d07b3-214d-414a-b8f7-993531bb7afd","pageContentBlockCanonId":"96bd1a5f-5e12-42f3-8c7f-745d66e2e62f","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"4f009eba-47e0-4048-9c02-8336982b3493","pageSectionCanonId":"9a21c7db-f00e-4c35-a6ee-649a2c5063b6","contentChunks":[{"pageContentChunkId":"fc08db0b-c4c7-4464-85d1-3d0bc61fa6e4","pageContentChunkCanonId":"740b4cfe-3e85-4eb9-aa5b-1e91fef8e1a3","htmlValue":"<h3><span style=\"white-space:pre-wrap\" id=\"isPasted\">不要过度追求趣味</span></h3><p><span id=\"isPasted\"><span style=\"white-space:pre-wrap\" id=\"isPasted\">看起来有趣或可爱的内容，实际效果可能并非如此。在争夺用户有限的注意力时，要有用。不要把重点放在趣味上：经过精心添加和测试的润色能更好地支撑 Google 的品牌。</span></span></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snipp